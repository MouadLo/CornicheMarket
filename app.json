{
  "expo": {
    "name": "Corniche Market",
    "slug": "corniche-market",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cornichemarket",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1d7a46"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mouadlo.cornichemarket"
    },
    "android": {
      "package": "com.mouadlo.cornichemarket",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1d7a46"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser Corniche Market à scanner les codes-barres des produits."
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
