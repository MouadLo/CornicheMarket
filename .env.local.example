# Local development overrides. Copy this file to .env.local (gitignored,
# never committed) and fill in the two values from `npx supabase status`
# after running `npx supabase start`.
#
# .env.local takes priority over .env, so you don't need to touch .env
# (which stays pointed at the real/production Supabase project) to work
# locally — just add this file and Expo picks it up automatically.
#
# Never put real production keys in here, and never commit .env.local.

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=paste-the-"Publishable"-key-from-supabase-status-here
